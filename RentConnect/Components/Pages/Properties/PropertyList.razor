@page "/properties"
@attribute [Authorize]
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using RentConnect.Application.Properties
@using RentConnect.Services
@using Microsoft.AspNetCore.Components.Authorization

@inject IPropertyService PropertyService
@inject CurrentUserProfileService CurrentUserProfileService

<PageTitle>Properties</PageTitle>

<main class="properties-page">
    <header class="page-header">
        <div>
            <p class="eyebrow">Places you manage or call home</p>
            <h1>Properties</h1>
            <p>View rental spaces, current occupancy, and property details.</p>
        </div>
        <AuthorizeView Roles="Landlord">
            <a class="primary-button" href="/properties/new">
                Add property
            </a>
        </AuthorizeView>
    </header>

    @if (_isLoading)
    {
        <section class="state-card">Loading properties...</section>
    }
    else if (_errorMessage is not null)
    {
        <section class="state-card error-card" role="alert">
            <h2>Unable to load properties</h2>
            <p>@_errorMessage</p>
        </section>
    }
    else if (_properties.Count == 0)
    {
        <section class="state-card empty-card">
            <span class="empty-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" focusable="false">
                    <path d="m3 11 9-7 9 7M5 10v10h14V10M9 20v-6h6v6" />
                </svg>
            </span>
            <h2>No properties connected yet</h2>
            <p>Add a property you own, or accept a tenancy invitation when one arrives.</p>
            <a class="secondary-button" href="/properties/new">Add your first property</a>
        </section>
    }
    else
    {
        <section class="property-grid" aria-label="Properties">
            @foreach (var property in _properties)
            {
                <a class="property-card" href="@($"/properties/{property.Id}")">
                    <div class="property-visual" aria-hidden="true">
                        <svg viewBox="0 0 48 48" focusable="false">
                            <path d="m7 23 17-14 17 14" />
                            <path d="M11 20v20h26V20M19 40V27h10v13" />
                        </svg>
                    </div>
                    <div class="card-heading">
                        <span class="access-badge @(property.CanManage ? "owner" : "resident")">
                            @(property.CanManage ? "Owner" : "Resident")
                        </span>
                        <span aria-hidden="true">→</span>
                    </div>
                    <h2>@property.Name</h2>
                    <p>@FormatAddress(property)</p>
                    <dl>
                        <div>
                            <dt>Spaces</dt>
                            <dd>@property.VisibleUnitCount</dd>
                        </div>
                        <div>
                            <dt>Active rentals</dt>
                            <dd>@property.ActiveTenancyCount</dd>
                        </div>
                    </dl>
                </a>
            }
        </section>
    }
</main>

@code {
    private IReadOnlyList<PropertySummary> _properties = [];
    private bool _isLoading = true;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var profileId = await CurrentUserProfileService
                .GetRequiredUserProfileIdAsync();
            _properties = await PropertyService
                .GetVisiblePropertiesAsync(profileId);
        }
        catch (Exception exception)
        {
            Console.Error.WriteLine(exception);
            _errorMessage = "Please try again. If the problem continues, contact support.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private static string FormatAddress(PropertySummary property)
    {
        var region = string.IsNullOrWhiteSpace(property.Region)
            ? string.Empty
            : $", {property.Region}";
        return $"{property.AddressLine1}, {property.City}{region}";
    }
}
