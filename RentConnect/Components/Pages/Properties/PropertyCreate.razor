@page "/properties/new"
@attribute [Authorize(Roles = "Landlord")]
@rendermode InteractiveServer

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@using RentConnect.Application.Properties
@using RentConnect.Core.Entities
@using RentConnect.Services

@inject IPropertyService PropertyService
@inject IPropertyImageService PropertyImages
@inject CurrentUserProfileService CurrentUserProfileService
@inject NavigationManager NavigationManager

<PageTitle>Add Property</PageTitle>

<main class="form-page">
    <header class="form-header">
        <div>
            <p class="eyebrow">Property portfolio</p>
            <h1>Add a property</h1>
            <p>Create the property first, then add its individual rental spaces.</p>
        </div>
        <BackNavigation Href="/properties" Label="Properties" />
    </header>

    @if (_createdPropertyId is Guid savedPropertyId)
    {
        <section class="form-card">
            <h2>Your property has been saved</h2>
            <p class="photo-error" role="alert">@_submitError</p>
            <a class="primary-button" href="@($"/properties/{savedPropertyId}")">Open property and add photographs</a>
        </section>
    }
    else
    {
    <EditForm Model="Input" OnValidSubmit="CreatePropertyAsync" FormName="create-property">
        <DataAnnotationsValidator />

        @if (_submitError is not null)
        {
            <div class="form-alert" role="alert">@_submitError</div>
        }
        <ValidationSummary class="validation-summary" />

        <section class="form-card">
            <div class="section-heading">
                <h2>Property identity</h2>
                <p>Use a familiar name that residents will recognize.</p>
            </div>
            <div class="field">
                <label for="property-name">Property name</label>
                <InputText id="property-name" class="form-control" @bind-Value="Input.Name" placeholder="For example: Maple House" />
                <ValidationMessage For="() => Input.Name" />
            </div>
        </section>

        <section class="form-card">
            <div class="section-heading">
                <h2>Address</h2>
                <p>This address is shown only to people connected to the property.</p>
            </div>
            <div class="field">
                <label for="address-line-1">Street address</label>
                <InputText id="address-line-1" class="form-control" @bind-Value="Input.AddressLine1" autocomplete="address-line1" />
                <ValidationMessage For="() => Input.AddressLine1" />
            </div>
            <div class="field">
                <label for="address-line-2">Apartment, suite, or building <span>Optional</span></label>
                <InputText id="address-line-2" class="form-control" @bind-Value="Input.AddressLine2" autocomplete="address-line2" />
            </div>
            <div class="form-grid">
                <div class="field">
                    <label for="city">City</label>
                    <InputText id="city" class="form-control" @bind-Value="Input.City" autocomplete="address-level2" />
                    <ValidationMessage For="() => Input.City" />
                </div>
                <div class="field">
                    <label for="region">Province or state</label>
                    <InputText id="region" class="form-control" @bind-Value="Input.Region" autocomplete="address-level1" />
                </div>
                <div class="field">
                    <label for="postal-code">Postal code</label>
                    <InputText id="postal-code" class="form-control" @bind-Value="Input.PostalCode" autocomplete="postal-code" />
                </div>
                <div class="field">
                    <label for="country-code">Country</label>
                    <InputSelect id="country-code" class="form-control" @bind-Value="Input.CountryCode" autocomplete="country">
                        <option value="CA">Canada</option>
                        <option value="US">United States</option>
                        <option value="GB">United Kingdom</option>
                        <option value="AU">Australia</option>
                        <option value="NZ">New Zealand</option>
                    </InputSelect>
                </div>
            </div>
        </section>

        <section class="form-card">
            <div class="section-heading"><h2>Property photograph</h2><p>Choose an optional photograph. You can add more after saving the property.</p></div>
            <div class="property-photo-picker">
                <label for="new-property-photo">Choose a photograph</label>
                <InputFile id="new-property-photo" OnChange="SelectPhotoAsync" accept="image/jpeg,image/png" disabled="@(_isSubmitting || _isSelectingPhoto)" />
                <small>JPEG or PNG, up to 5 MB.</small>
            </div>
            @if (_isSelectingPhoto) { <p role="status">Preparing preview...</p> }
            @if (_photoPreview is not null)
            {
                <figure class="property-photo-preview"><img src="@_photoPreview" alt="Selected property photograph preview" /><figcaption>@_selectedPhoto?.Name</figcaption></figure>
                <button type="button" class="text-button" disabled="@_isSubmitting" @onclick="ClearPhoto">Remove selected photograph</button>
            }
            @if (_photoError is not null) { <p class="photo-error" role="alert">@_photoError</p> }
        </section>

        <div class="form-actions">
            <a href="/properties">Cancel</a>
            <button type="submit" class="primary-button" disabled="@(_isSubmitting || _isSelectingPhoto)">
                @(_isSubmitting ? "Adding property..." : "Add property")
            </button>
        </div>
    </EditForm>
    }
</main>

@code {
    private readonly PropertyInput Input = new();
    private bool _isSubmitting;
    private string? _submitError;

    private IBrowserFile? _selectedPhoto;
    private string? _photoPreview, _photoError;
    private bool _isSelectingPhoto;
    private Guid? _createdPropertyId;

    private async Task SelectPhotoAsync(InputFileChangeEventArgs args)
    {
        _isSelectingPhoto = true; _photoError = null; _selectedPhoto = null; _photoPreview = null;
        try
        {
            var file = args.File;
            if (file.Size > PropertyImage.MaxBytes) throw new ArgumentException("Choose a photograph smaller than 5 MB.");
            if (file.ContentType is not ("image/jpeg" or "image/png")) throw new ArgumentException("Choose a JPEG or PNG photograph.");
            var preview = await file.RequestImageFileAsync("image/png",480,320);
            await using var stream = preview.OpenReadStream(PropertyImage.MaxBytes);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            _photoPreview = $"data:image/png;base64,{Convert.ToBase64String(buffer.ToArray())}";
            _selectedPhoto = file;
        }
        catch (Exception exception) { Console.Error.WriteLine(exception); _photoError = "That photograph could not be previewed. Choose a JPEG or PNG file up to 5 MB."; }
        finally { _isSelectingPhoto = false; }
    }

    private void ClearPhoto() { _selectedPhoto = null; _photoPreview = null; _photoError = null; }

    private async Task CreatePropertyAsync()
    {
        if (_isSubmitting || _isSelectingPhoto || _createdPropertyId.HasValue) return;
        _isSubmitting = true; _submitError = null;
        Guid? savedPropertyId = null;
        try
        {
            var profileId = await CurrentUserProfileService.GetRequiredUserProfileIdAsync();
            var propertyId = await PropertyService.CreateAsync(
                new CreatePropertyCommand(Input.Name,Input.AddressLine1,Input.AddressLine2,Input.City,Input.Region,Input.PostalCode,Input.CountryCode),profileId);
            savedPropertyId = propertyId;
            if (_selectedPhoto is not null)
            {
                await using var content = _selectedPhoto.OpenReadStream(PropertyImage.MaxBytes);
                await PropertyImages.AddAsync(propertyId,profileId,content);
            }
            NavigationManager.NavigateTo($"/properties/{propertyId}");
        }
        catch (Exception exception)
        {
            Console.Error.WriteLine(exception);
            if (savedPropertyId.HasValue)
            {
                _createdPropertyId = savedPropertyId;
                _submitError = "The property was saved, but its photograph could not be uploaded. Open the property to add it again.";
            }
            else _submitError = "The property could not be added. Check the address and try again.";
            _isSubmitting = false;
        }
    }

    private sealed class PropertyInput
    {
        [Required(ErrorMessage = "Enter a property name.")]
        [StringLength(150)]
        public string Name { get; set; } = string.Empty;

        [Required(ErrorMessage = "Enter a street address.")]
        [StringLength(200)]
        public string AddressLine1 { get; set; } = string.Empty;

        [StringLength(200)]
        public string? AddressLine2 { get; set; }

        [Required(ErrorMessage = "Enter a city.")]
        [StringLength(100)]
        public string City { get; set; } = string.Empty;

        [StringLength(100)]
        public string? Region { get; set; } = "Alberta";

        [StringLength(20)]
        public string? PostalCode { get; set; }

        [Required]
        [StringLength(2, MinimumLength = 2)]
        public string CountryCode { get; set; } = "CA";
    }
}
