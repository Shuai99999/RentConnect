@page "/maintenance/{RequestId:guid}"
@attribute [Authorize]
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components
@using RentConnect.Application.Maintenance
@using RentConnect.Core.Enums
@using RentConnect.Services
@using System.ComponentModel.DataAnnotations
@using RentConnect.Core.Entities

@inject IMaintenanceService MaintenanceService
@inject CurrentUserProfileService CurrentUserProfileService

<PageTitle>@(_request?.Title ?? "Maintenance Request")</PageTitle>

<main class="maintenance-details-page">
    @if (_isLoading)
    {
        <section class="state-panel">
            <p>Loading maintenance request...</p>
        </section>
    }
    else if (_errorMessage is not null)
    {
        <section class="state-panel error-panel"
                 role="alert">
            <h1>Unable to load this request</h1>
            <p>@_errorMessage</p>

            <a class="secondary-button"
               href="/maintenance">
                Return to maintenance requests
            </a>
        </section>
    }
    else if (_request is null)
    {
        <section class="state-panel">
            <h1>Maintenance request not found</h1>
            <p>
                The request may no longer exist, or you may not
                have permission to view it.
            </p>

            <a class="secondary-button"
               href="/maintenance">
                Return to maintenance requests
            </a>
        </section>
    }
    else
    {
        <header class="details-header">
            <BackNavigation Href="/maintenance"
                            Label="Maintenance requests" />

            <div class="header-content">
                <div>
                    <p class="page-eyebrow">
                        Maintenance Request
                    </p>

                    <h1>@_request.Title</h1>

                    <p class="request-reference">
                        Reference: @_request.Id
                    </p>
                </div>

                <div class="header-badges">
                    <span class="status-badge @GetStatusCssClass(_request.Status)">
                        @GetStatusText(_request.Status)
                    </span>

                    @if (_request.Visibility ==
                         MaintenanceVisibility.PrivateToReporterAndManagement)
                    {
                        <span class="private-badge">
                            Private
                        </span>
                    }
                </div>
            </div>
        </header>

        <section class="details-grid"
                 aria-label="Request information">
            <article class="detail-card">
                <span>Category</span>
                <strong>
                    @GetCategoryText(_request.Category)
                </strong>
            </article>

            <article class="detail-card">
                <span>Priority</span>
                <strong class="@GetPriorityCssClass(_request.Priority)">
                    @GetPriorityText(_request.Priority)
                </strong>
            </article>

            <article class="detail-card">
                <span>Created</span>
                <strong>
                    @FormatDateTime(_request.CreatedAtUtc)
                </strong>
            </article>

            <article class="detail-card">
                <span>Last updated</span>
                <strong>
                    @FormatDateTime(_request.UpdatedAtUtc)
                </strong>
            </article>

            <article class="detail-card">
                <span>Assigned to</span>
                <strong>@(_request.AssignedToDisplayName ?? "Unassigned")</strong>
            </article>
        </section>

        @if (_request.Permissions.CanAssign)
        {
            <section class="content-card assignment-card">
                <div class="section-heading">
                    <h2>Request owner</h2>
                    <p>Assign a property manager to coordinate the next steps.</p>
                </div>
                <div class="assignment-controls">
                    <select @bind="_selectedAssigneeId" aria-label="Assigned manager">
                        <option value="">Unassigned</option>
                        @foreach (var assignee in _assigneeOptions)
                        {
                            <option value="@assignee.UserProfileId">@assignee.DisplayName</option>
                        }
                    </select>
                    <button type="button"
                            class="secondary-button"
                            disabled="@_isAssigning"
                            @onclick="AssignAsync">
                        @(_isAssigning ? "Saving…" : "Save assignment")
                    </button>
                </div>
                @if (_assignmentError is not null)
                {
                    <div class="form-alert" role="alert">@_assignmentError</div>
                }
            </section>
        }

        <section class="content-card">
            <div class="section-heading">
                <h2>Description</h2>
            </div>

            <p class="request-description">
                @_request.Description
            </p>
        </section>

        @if (_request.ScheduledForUtc.HasValue)
        {
            <section class="content-card">
                <div class="section-heading">
                    <h2>Scheduled visit</h2>
                </div>

                <p>
                    @_request.ScheduledForUtc.Value
                        .ToString("MMM d, yyyy 'at' HH:mm 'UTC'")
                </p>
            </section>
        }

        @if (!string.IsNullOrWhiteSpace(
                 _request.ResolutionNotes))
        {
            <section class="content-card resolution-card">
                <div class="section-heading">
                    <h2>Resolution</h2>
                </div>

                <p class="request-description">
                    @_request.ResolutionNotes
                </p>
            </section>
        }

        <section class="content-card">
            <div class="section-heading">
                <h2>Status history</h2>
                <p>
                    Follow the progress of this maintenance request.
                </p>
            </div>

            <ol class="timeline">
                <li class="timeline-item">
                    <div class="timeline-marker"></div>

                    <div>
                        <strong>Submitted</strong>
                        <time>
                            @FormatDateTime(_request.CreatedAtUtc)
                        </time>
                    </div>
                </li>

                @foreach (var change in _request.StatusHistory)
                {
                    <li class="timeline-item">
                        <div class="timeline-marker"></div>

                        <div>
                            <strong>
                                @GetStatusText(change.ToStatus)
                            </strong>

                            <time>
                                @FormatDateTime(change.ChangedAtUtc)
                            </time>

                            @if (!string.IsNullOrWhiteSpace(
                                     change.Note))
                            {
                                <p>@change.Note</p>
                            }
                        </div>
                    </li>
                }
            </ol>
        </section>

        @if (HasAvailableStatusActions())
        {
            <section class="content-card action-card">
                <div class="section-heading">
                    <h2>Request actions</h2>
                    <p>
                        Available actions depend on your role and the
                        current request status.
                    </p>
                </div>

                <div class="status-action-buttons">
                    @if (_request.Permissions.CanAcknowledge)
                    {
                        <button type="button"
                                class="action-button"
                                @onclick="() => SelectStatusAction(MaintenanceAction.Acknowledge)">
                            Acknowledge
                        </button>
                    }

                    @if (_request.Permissions.CanSchedule)
                    {
                        <button type="button"
                                class="action-button"
                                @onclick="() => SelectStatusAction(MaintenanceAction.Schedule)">
                            Schedule Visit
                        </button>
                    }

                    @if (_request.Permissions.CanStartWork)
                    {
                        <button type="button"
                                class="action-button"
                                @onclick="() => SelectStatusAction(MaintenanceAction.StartWork)">
                            Start Work
                        </button>
                    }

                    @if (_request.Permissions.CanResolve)
                    {
                        <button type="button"
                                class="action-button"
                                @onclick="() => SelectStatusAction(MaintenanceAction.Resolve)">
                            Resolve
                        </button>
                    }

                    @if (_request.Permissions.CanClose)
                    {
                        <button type="button"
                                class="action-button"
                                @onclick="() => SelectStatusAction(MaintenanceAction.Close)">
                            Close Request
                        </button>
                    }

                    @if (_request.Permissions.CanReopen)
                    {
                        <button type="button"
                                class="action-button"
                                @onclick="() => SelectStatusAction(MaintenanceAction.Reopen)">
                            Reopen
                        </button>
                    }

                    @if (_request.Permissions.CanCancel)
                    {
                        <button type="button"
                                class="action-button danger-outline-button"
                                @onclick="() => SelectStatusAction(MaintenanceAction.Cancel)">
                            Cancel Request
                        </button>
                    }
                </div>

                @if (_selectedStatusAction is MaintenanceAction action)
                {
                    <div class="status-action-editor">
                        <h3>@GetActionTitle(action)</h3>

                        <EditForm Model="StatusActionInput"
                                  OnValidSubmit="ExecuteStatusActionAsync"
                                  class="status-action-form">
                            <DataAnnotationsValidator />

                            @if (action == MaintenanceAction.Schedule)
                            {
                                <label for="scheduled-for">
                                    Scheduled time (UTC)
                                </label>

                                <InputDate id="scheduled-for"
                                           class="action-input"
                                           Type="InputDateType.DateTimeLocal"
                                           @bind-Value="StatusActionInput.ScheduledForUtc" />
                            }

                            <label for="status-note">
                                @GetNoteLabel(action)
                            </label>

                            <InputTextArea id="status-note"
                                           class="action-input action-note-input"
                                           @bind-Value="StatusActionInput.Note"
                                           placeholder="@GetNotePlaceholder(action)" />

                            @if (_statusActionError is not null)
                            {
                                <div class="form-alert"
                                     role="alert">
                                    @_statusActionError
                                </div>
                            }

                            <div class="inline-actions">
                                <button type="submit"
                                        class="small-primary-button">
                                    @GetActionButtonText(action)
                                </button>

                                <button type="button"
                                        class="text-button"
                                        @onclick="CancelStatusAction">
                                    Keep Current Status
                                </button>
                            </div>
                        </EditForm>
                    </div>
                }
            </section>
        }

        <section class="content-card">
            <div class="section-heading">
                <h2>Photos</h2>
                <p>
                    Add photos that help document the issue and repair.
                </p>
            </div>

            @if (_attachmentError is not null)
            {
                <div class="form-alert"
                     role="alert">
                    @_attachmentError
                </div>
            }

            @if (_request.Attachments.Count == 0)
            {
                <div class="empty-attachments">
                    No photos have been added yet.
                </div>
            }
            else
            {
                <div class="attachment-grid">
                    @foreach (var attachment in _request.Attachments)
                    {
                        <article class="attachment-card">
                            <a class="attachment-preview"
                               href="@GetAttachmentContentUrl(attachment.Id)"
                               target="_blank"
                               rel="noopener noreferrer">
                                <img src="@GetAttachmentContentUrl(attachment.Id)"
                                     alt="@attachment.OriginalFileName"
                                     loading="lazy" />
                            </a>

                            <div class="attachment-details">
                                <strong title="@attachment.OriginalFileName">
                                    @attachment.OriginalFileName
                                </strong>

                                <span>
                                    @FormatFileSize(attachment.FileSizeBytes)
                                    · @FormatDateTime(attachment.UploadedAtUtc)
                                </span>

                                @if (attachment.CanDelete)
                                {
                                    <div class="attachment-actions">
                                        @if (_deleteConfirmationAttachmentId ==
                                             attachment.Id)
                                        {
                                            <span class="delete-confirmation">
                                                Delete this photo?
                                            </span>

                                            <button type="button"
                                                    class="danger-button"
                                                    @onclick="() => DeleteAttachmentAsync(attachment.Id)">
                                                Confirm Delete
                                            </button>

                                            <button type="button"
                                                    class="text-button"
                                                    @onclick="CancelAttachmentDelete">
                                                Keep Photo
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button"
                                                    class="delete-button"
                                                    @onclick="() => BeginAttachmentDelete(attachment.Id)">
                                                Delete
                                            </button>
                                        }
                                    </div>
                                }
                            </div>
                        </article>
                    }
                </div>
            }

            @if (_request.Permissions.CanAddAttachment)
            {
                <div class="attachment-uploader">
                    <label for="maintenance-photo">
                        Add a photo
                    </label>

                    <InputFile @key="_attachmentInputVersion"
                               id="maintenance-photo"
                               class="attachment-input"
                               accept="image/jpeg,image/png,image/webp"
                               OnChange="SelectAttachment" />

                    <p class="input-help">
                        JPEG, PNG, or WebP. Maximum file size: 10 MB.
                    </p>

                    @if (_selectedAttachment is not null)
                    {
                        <p class="selected-attachment">
                            Selected:
                            <strong>@_selectedAttachment.Name</strong>
                            (@FormatFileSize(_selectedAttachment.Size))
                        </p>
                    }

                    <button type="button"
                            class="primary-button"
                            disabled="@(_selectedAttachment is null ||
                                        _isUploadingAttachment)"
                            @onclick="UploadAttachmentAsync">
                        @(_isUploadingAttachment
                            ? "Uploading..."
                            : "Upload Photo")
                    </button>
                </div>
            }
            else if (_request.Status is
                     MaintenanceStatus.Closed or
                     MaintenanceStatus.Cancelled)
            {
                <div class="attachments-closed">
                    Photos cannot be added to a closed or cancelled request.
                </div>
            }
        </section>

        <section class="content-card">
            <div class="section-heading">
                <h2>Conversation</h2>
                <p>
                    Messages from tenants and property management
                    will appear here.
                </p>
            </div>

            @if (_messageActionError is not null)
            {
                <div class="form-alert"
                     role="alert">
                    @_messageActionError
                </div>
            }

            @if (_request.Messages.Count == 0)
            {
                <div class="empty-conversation">
                    No messages have been posted yet.
                </div>
            }
            else
            {
                <div class="message-list">
                    @foreach (var message in _request.Messages)
                    {
                        <article class="message-card">
                            <header>
                                <strong>
                                    @(message.AuthorUserProfileId ==
                                      _currentUserProfileId
                                        ? "You"
                                        : "Participant")
                                </strong>

                                <time>
                                    @FormatDateTime(message.CreatedAtUtc)
                                </time>
                            </header>

                            @if (message.IsDeleted)
                            {
                                <p class="deleted-message">
                                    This message was deleted.
                                </p>
                            }
                            else if (_editingMessageId == message.Id)
                            {
                                <div class="edit-message-composer">
                                    <EditForm Model="EditMessageInput"
                                              OnValidSubmit="SaveMessageEditAsync"
                                              class="edit-message-form">
                                        <DataAnnotationsValidator />

                                        <label for="@($"edit-message-{message.Id}")">
                                            Edit message
                                        </label>

                                        <InputTextArea id="@($"edit-message-{message.Id}")"
                                                       class="message-input"
                                                       @bind-Value="EditMessageInput.Body" />

                                        <ValidationMessage For="() => EditMessageInput.Body"
                                                           class="field-validation" />

                                        <div class="inline-actions">
                                            <button type="submit"
                                                    class="small-primary-button">
                                                Save Changes
                                            </button>

                                            <button type="button"
                                                    class="text-button"
                                                    @onclick="CancelMessageEdit">
                                                Cancel
                                            </button>
                                        </div>
                                    </EditForm>
                                </div>
                            }
                            else
                            {
                                <p class="request-description">
                                    @message.Body
                                </p>

                                @if (message.EditedAtUtc.HasValue)
                                {
                                    <small>
                                        Edited
                                    </small>
                                }

                                @if (message.CanEdit || message.CanDelete)
                                {
                                    <div class="message-actions">
                                        @if (message.CanEdit)
                                        {
                                            <button type="button"
                                                    class="text-button"
                                                    @onclick="() => BeginMessageEdit(message)">
                                                Edit
                                            </button>
                                        }

                                        @if (message.CanDelete)
                                        {
                                            @if (_deleteConfirmationMessageId == message.Id)
                                            {
                                                <span class="delete-confirmation">
                                                    Delete this message?
                                                </span>

                                                <button type="button"
                                                        class="danger-button"
                                                        @onclick="() => DeleteMessageAsync(message.Id)">
                                                    Confirm Delete
                                                </button>

                                                <button type="button"
                                                        class="text-button"
                                                        @onclick="CancelMessageDelete">
                                                    Keep Message
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="button"
                                                        class="delete-button"
                                                        @onclick="() => BeginMessageDelete(message.Id)">
                                                    Delete
                                                </button>
                                            }
                                        }
                                    </div>
                                }
                            }
                        </article>
                    }
                </div>
            }

            @if (_request.Permissions.CanPostMessage)
            {
                <div class="message-composer">
                    <EditForm Model="MessageInput"
                              OnValidSubmit="PostMessageAsync"
                              class="message-form">
                        <DataAnnotationsValidator />

                        <label for="message-body">
                            Message
                        </label>

                        <InputTextArea id="message-body"
                                       class="message-input"
                                       @bind-Value="MessageInput.Body"
                                       placeholder="Share an update or ask a question." />

                        <ValidationMessage For="() => MessageInput.Body"
                                           class="field-validation" />

                        @if (_messageError is not null)
                        {
                            <div class="form-alert"
                                 role="alert">
                                @_messageError
                            </div>
                        }

                        <div class="message-form-actions">
                            <button type="submit"
                                    class="primary-button">
                                Post Message
                            </button>
                        </div>
                    </EditForm>
                </div>
            }
            else
            {
                <div class="conversation-closed">
                    New messages cannot be posted to this request.
                </div>
            }
        </section>
    }
</main>

@code {
    [Parameter]
    public Guid RequestId { get; set; }

    private MaintenanceRequestDetails? _request;
    private Guid _currentUserProfileId;
    private bool _isLoading = true;
    private string? _errorMessage;
    private string? _messageError;
    private string? _messageActionError;
    private Guid? _editingMessageId;
    private Guid? _deleteConfirmationMessageId;
    private Guid? _deleteConfirmationAttachmentId;
    private MaintenanceAction? _selectedStatusAction;
    private string? _statusActionError;
    private string? _attachmentError;
    private IBrowserFile? _selectedAttachment;
    private bool _isUploadingAttachment;
    private int _attachmentInputVersion;
    private IReadOnlyList<MaintenanceAssigneeOption> _assigneeOptions = [];
    private Guid? _selectedAssigneeId;
    private bool _isAssigning;
    private string? _assignmentError;

    private MessageInputModel MessageInput { get; set; } =
        new();

    private MessageInputModel EditMessageInput { get; set; } =
        new();

    private StatusActionInputModel StatusActionInput { get; set; } =
        new();

    protected override async Task OnParametersSetAsync()
    {
        _isLoading = true;
        _request = null;
        _errorMessage = null;

        try
        {
            _currentUserProfileId =
                await CurrentUserProfileService
                    .GetRequiredUserProfileIdAsync();

            _request =
                await MaintenanceService.GetDetailsAsync(
                    RequestId,
                    _currentUserProfileId);

            if (_request?.Permissions.CanAssign == true)
            {
                _assigneeOptions = await MaintenanceService.GetAssigneeOptionsAsync(
                    RequestId,
                    _currentUserProfileId);
                _selectedAssigneeId = _request.AssignedToUserProfileId;
            }
        }
        catch (Exception exception)
        {
            _errorMessage =
                "Please try again. If the problem continues, contact support.";

            Console.Error.WriteLine(exception);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task AssignAsync()
    {
        if (_isAssigning)
        {
            return;
        }

        _isAssigning = true;
        _assignmentError = null;

        try
        {
            await MaintenanceService.AssignAsync(
                new AssignMaintenanceRequestCommand(RequestId, _selectedAssigneeId),
                _currentUserProfileId);
            await ReloadRequestAsync();
        }
        catch (KeyNotFoundException)
        {
            _assignmentError = "This request is unavailable, or you cannot assign it.";
        }
        catch (ArgumentException exception)
        {
            _assignmentError = exception.Message;
        }
        catch (Exception exception)
        {
            _assignmentError = "The assignment could not be saved. Please try again.";
            Console.Error.WriteLine(exception);
        }
        finally
        {
            _isAssigning = false;
        }
    }

    private async Task PostMessageAsync()
    {
        _messageError = null;

        try
        {
            await MaintenanceService.AddMessageAsync(
                new AddMaintenanceMessageCommand(
                    RequestId,
                    MessageInput.Body),
                _currentUserProfileId);

            MessageInput = new();

            await ReloadRequestAsync();
        }
        catch (KeyNotFoundException)
        {
            _messageError =
                "This request is no longer available, or messages cannot be posted to it.";
        }
        catch (ArgumentException exception)
        {
            _messageError = exception.Message;
        }
        catch (Exception exception)
        {
            _messageError =
                "The message could not be posted. Please try again.";

            Console.Error.WriteLine(exception);
        }
    }

    private void BeginMessageEdit(
        MaintenanceMessageItem message)
    {
        _messageActionError = null;
        _deleteConfirmationMessageId = null;
        _editingMessageId = message.Id;

        EditMessageInput = new MessageInputModel
        {
            Body = message.Body ?? string.Empty
        };
    }

    private void CancelMessageEdit()
    {
        _editingMessageId = null;
        EditMessageInput = new();
        _messageActionError = null;
    }

    private async Task SaveMessageEditAsync()
    {
        if (_editingMessageId is not Guid messageId)
        {
            return;
        }

        _messageActionError = null;

        try
        {
            await MaintenanceService.EditMessageAsync(
                new EditMaintenanceMessageCommand(
                    messageId,
                    EditMessageInput.Body),
                _currentUserProfileId);

            _editingMessageId = null;
            EditMessageInput = new();

            await ReloadRequestAsync();
        }
        catch (KeyNotFoundException)
        {
            _messageActionError =
                "This message is no longer available, or you do not have permission to edit it.";
        }
        catch (ArgumentException exception)
        {
            _messageActionError = exception.Message;
        }
        catch (InvalidOperationException exception)
        {
            _messageActionError = exception.Message;
        }
        catch (Exception exception)
        {
            _messageActionError =
                "The message could not be updated. Please try again.";

            Console.Error.WriteLine(exception);
        }
    }

    private void BeginMessageDelete(Guid messageId)
    {
        _messageActionError = null;
        _editingMessageId = null;
        EditMessageInput = new();
        _deleteConfirmationMessageId = messageId;
    }

    private void CancelMessageDelete()
    {
        _deleteConfirmationMessageId = null;
        _messageActionError = null;
    }

    private async Task DeleteMessageAsync(Guid messageId)
    {
        _messageActionError = null;

        try
        {
            await MaintenanceService.DeleteMessageAsync(
                new DeleteMaintenanceMessageCommand(messageId),
                _currentUserProfileId);

            _deleteConfirmationMessageId = null;

            await ReloadRequestAsync();
        }
        catch (KeyNotFoundException)
        {
            _messageActionError =
                "This message is no longer available, or you do not have permission to delete it.";
        }
        catch (InvalidOperationException exception)
        {
            _messageActionError = exception.Message;
        }
        catch (Exception exception)
        {
            _messageActionError =
                "The message could not be deleted. Please try again.";

            Console.Error.WriteLine(exception);
        }
    }

    private void SelectAttachment(
        InputFileChangeEventArgs eventArgs)
    {
        _attachmentError = null;
        _selectedAttachment = null;

        var file = eventArgs.File;
        var normalizedContentType =
            file.ContentType.Trim().ToLowerInvariant();

        if (file.Size <= 0)
        {
            _attachmentError =
                "Select a photo that is not empty.";
            return;
        }

        if (file.Size >
            MaintenanceAttachment.MaxFileSizeBytes)
        {
            _attachmentError =
                "The photo cannot exceed 10 MB.";
            return;
        }

        if (normalizedContentType is not
            ("image/jpeg" or
             "image/png" or
             "image/webp"))
        {
            _attachmentError =
                "Select a JPEG, PNG, or WebP image.";
            return;
        }

        _selectedAttachment = file;
    }

    private async Task UploadAttachmentAsync()
    {
        if (_selectedAttachment is not IBrowserFile file ||
            _isUploadingAttachment)
        {
            return;
        }

        _attachmentError = null;
        _isUploadingAttachment = true;

        try
        {
            await using var content = file.OpenReadStream(
                MaintenanceAttachment.MaxFileSizeBytes);

            await MaintenanceService.AddAttachmentAsync(
                new AddMaintenanceAttachmentCommand(
                    RequestId,
                    file.Name,
                    file.ContentType,
                    content),
                _currentUserProfileId);

            _selectedAttachment = null;
            _attachmentInputVersion++;

            await ReloadRequestAsync();
        }
        catch (KeyNotFoundException)
        {
            _attachmentError =
                "This request is no longer available, or you do not have permission to add photos.";
        }
        catch (ArgumentException exception)
        {
            _attachmentError = exception.Message;
        }
        catch (IOException exception)
        {
            _attachmentError =
                "The photo could not be stored. Please try again.";

            Console.Error.WriteLine(exception);
        }
        catch (Exception exception)
        {
            _attachmentError =
                "The photo could not be uploaded. Please try again.";

            Console.Error.WriteLine(exception);
        }
        finally
        {
            _isUploadingAttachment = false;
        }
    }

    private void BeginAttachmentDelete(Guid attachmentId)
    {
        _attachmentError = null;
        _deleteConfirmationAttachmentId = attachmentId;
    }

    private void CancelAttachmentDelete()
    {
        _deleteConfirmationAttachmentId = null;
        _attachmentError = null;
    }

    private async Task DeleteAttachmentAsync(
        Guid attachmentId)
    {
        _attachmentError = null;

        try
        {
            await MaintenanceService.DeleteAttachmentAsync(
                new DeleteMaintenanceAttachmentCommand(
                    attachmentId),
                _currentUserProfileId);

            _deleteConfirmationAttachmentId = null;

            await ReloadRequestAsync();
        }
        catch (KeyNotFoundException)
        {
            _attachmentError =
                "This photo is no longer available, or you do not have permission to delete it.";
        }
        catch (Exception exception)
        {
            _attachmentError =
                "The photo could not be deleted. Please try again.";

            Console.Error.WriteLine(exception);
        }
    }

    private async Task ReloadRequestAsync()
    {
        _request =
            await MaintenanceService.GetDetailsAsync(
                RequestId,
                _currentUserProfileId);
    }

    private static string GetAttachmentContentUrl(
        Guid attachmentId)
    {
        return
            $"/maintenance/attachments/{attachmentId:D}/content";
    }

    private static string FormatFileSize(long fileSizeBytes)
    {
        const double bytesPerKilobyte = 1024;
        const double bytesPerMegabyte =
            bytesPerKilobyte * 1024;

        if (fileSizeBytes < bytesPerKilobyte)
        {
            return $"{fileSizeBytes} bytes";
        }

        if (fileSizeBytes >= bytesPerMegabyte)
        {
            return
                $"{fileSizeBytes / bytesPerMegabyte:0.##} MB";
        }

        return
            $"{fileSizeBytes / bytesPerKilobyte:0.##} KB";
    }

    private bool HasAvailableStatusActions()
    {
        if (_request is null)
        {
            return false;
        }

        var permissions = _request.Permissions;

        return permissions.CanCancel ||
               permissions.CanAcknowledge ||
               permissions.CanSchedule ||
               permissions.CanStartWork ||
               permissions.CanResolve ||
               permissions.CanClose ||
               permissions.CanReopen;
    }

    private void SelectStatusAction(MaintenanceAction action)
    {
        _selectedStatusAction = action;
        _statusActionError = null;
        StatusActionInput = new();
    }

    private void CancelStatusAction()
    {
        _selectedStatusAction = null;
        _statusActionError = null;
        StatusActionInput = new();
    }

    private async Task ExecuteStatusActionAsync()
    {
        if (_selectedStatusAction is not MaintenanceAction action)
        {
            return;
        }

        _statusActionError = null;

        if (action == MaintenanceAction.Schedule &&
            StatusActionInput.ScheduledForUtc is null)
        {
            _statusActionError =
                "Enter the scheduled time in UTC.";
            return;
        }

        if (action is MaintenanceAction.Resolve or
                MaintenanceAction.Reopen &&
            string.IsNullOrWhiteSpace(StatusActionInput.Note))
        {
            _statusActionError = action == MaintenanceAction.Resolve
                ? "Enter resolution notes."
                : "Enter a reason for reopening the request.";
            return;
        }

        DateTimeOffset? scheduledForUtc = null;

        if (StatusActionInput.ScheduledForUtc is DateTime scheduledTime)
        {
            scheduledForUtc = new DateTimeOffset(
                DateTime.SpecifyKind(
                    scheduledTime,
                    DateTimeKind.Utc));
        }

        try
        {
            await MaintenanceService.ChangeStatusAsync(
                new ChangeMaintenanceStatusCommand(
                    RequestId,
                    action,
                    scheduledForUtc,
                    StatusActionInput.Note),
                _currentUserProfileId);

            _selectedStatusAction = null;
            StatusActionInput = new();

            await ReloadRequestAsync();
        }
        catch (KeyNotFoundException)
        {
            _statusActionError =
                "This action is no longer available, or you do not have permission to perform it.";
        }
        catch (ArgumentException exception)
        {
            _statusActionError = exception.Message;
        }
        catch (InvalidOperationException exception)
        {
            _statusActionError = exception.Message;
        }
        catch (Exception exception)
        {
            _statusActionError =
                "The request status could not be updated. Please try again.";

            Console.Error.WriteLine(exception);
        }
    }

