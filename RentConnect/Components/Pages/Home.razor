@page "/"
@attribute [Authorize]
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using RentConnect.Application.Billing
@using RentConnect.Application.Listings
@using RentConnect.Application.Maintenance
@using RentConnect.Application.Notifications
@using RentConnect.Application.Properties
@using RentConnect.Core.Enums
@using RentConnect.Services

@inject AuthenticationStateProvider AuthenticationStateProvider
@inject CurrentUserProfileService CurrentUserProfileService
@inject IPropertyService PropertyService
@inject IRentalListingService RentalListingService
@inject IMaintenanceService MaintenanceService
@inject ISharedBillService SharedBillService
@inject INotificationService NotificationService

<PageTitle>Dashboard</PageTitle>

<main class="dashboard-page">
    @if (_isLoading)
    {
        <section class="dashboard-state" aria-live="polite">
            <span class="state-spinner" aria-hidden="true"></span>
            <p>Preparing your dashboard...</p>
        </section>
    }
    else if (_errorMessage is not null)
    {
        <section class="dashboard-state error-state" role="alert">
            <span class="state-symbol" aria-hidden="true">!</span>
            <h1>We couldn't load your dashboard</h1>
            <p>@_errorMessage</p>
            <button type="button" class="secondary-button" @onclick="LoadDashboardAsync">
                Try again
            </button>
        </section>
    }
    else
    {
        <header class="dashboard-hero">
            <div class="hero-copy">
                <p class="eyebrow">@(_isLandlord ? "Landlord workspace" : "Renter overview")</p>
                <h1>Welcome back, @GetFirstName(_displayName)</h1>
                <p>@GetHeroDescription()</p>
            </div>

            <div class="quick-actions" aria-label="Quick actions">
                @if (_isLandlord)
                {
                    <a class="primary-action" href="/properties/new">
                        <span aria-hidden="true">+</span>
                        Add property
                    </a>
                    <a class="secondary-action" href="/listings/manage">
                        Manage listings
                    </a>
                    <a class="secondary-action" href="/rental-applications">
                        Applications
                    </a>
                    <a class="secondary-action" href="/bills/new">
                        Add bill
                    </a>
                }
                else
                {
                    <a class="primary-action" href="/listings">
                        <span aria-hidden="true">⌕</span>
                        Find a home
                    </a>
                    <a class="secondary-action" href="/maintenance/new">
                        Report a problem
                    </a>
                    <a class="secondary-action" href="/tenancies">
                        My tenancy
                    </a>
                    <a class="secondary-action" href="/bills">
                        My bills
                    </a>
                }
            </div>
        </header>

        <section class="summary-grid" aria-label="Account summary">
            @if (_isLandlord)
            {
                <a class="summary-card" href="/properties">
                    <span class="summary-icon property-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" focusable="false">
                            <path d="m3 11 9-7 9 7" />
                            <path d="M5 10v10h14V10M9 20v-6h6v6" />
                        </svg>
                    </span>
                    <span class="summary-copy">
                        <small>Properties</small>
                        <strong>@_propertyCount</strong>
                        <span>@GetPropertySummary()</span>
                    </span>
                    <span class="card-arrow" aria-hidden="true">→</span>
                </a>

                <a class="summary-card" href="/listings/manage">
                    <span class="summary-icon listing-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" focusable="false">
                            <path d="M4 5h16v14H4z" />
                            <path d="M8 9h8M8 13h6" />
                        </svg>
                    </span>
                    <span class="summary-copy">
                        <small>Published listings</small>
                        <strong>@_publishedListingCount</strong>
                        <span>@GetListingSummary()</span>
                    </span>
                    <span class="card-arrow" aria-hidden="true">→</span>
                </a>

                <a class="summary-card" href="/rental-applications">
                    <span class="summary-icon application-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" focusable="false">
                            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                            <circle cx="9" cy="7" r="4" />
                            <path d="m17 11 2 2 4-4" />
                        </svg>
                    </span>
                    <span class="summary-copy">
                        <small>Pending applications</small>
                        <strong>@_pendingApplicationCount</strong>
                        <span>@GetApplicationSummary()</span>
                    </span>
                    <span class="card-arrow" aria-hidden="true">→</span>
                </a>

                <a class="summary-card" href="/maintenance">
                    <span class="summary-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" focusable="false">
                            <path d="m14.5 6.5 3-3a4 4 0 0 1-5 5l-6.8 6.8a2.4 2.4 0 1 1-3-3l6.8-6.8a4 4 0 0 1 5-5l-3 3 3 3Z" />
                        </svg>
                    </span>
                    <span class="summary-copy">
                        <small>Active requests</small>
                        <strong>@_activeRequestCount</strong>
                        <span>@GetRequestSummary()</span>
                    </span>
                    <span class="card-arrow" aria-hidden="true">→</span>
                </a>
            }
            else
            {
                <a class="summary-card rental-summary" href="/tenancies">
                    <span class="summary-icon rental-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" focusable="false">
                            <path d="m3 11 9-7 9 7" />
                            <path d="M5 10v10h14V10M9 20v-6h6v6" />
                        </svg>
                    </span>
                    <span class="summary-copy">
                        <small>Active tenancies</small>
                        <strong>@_tenancies.Count</strong>
                        <span>@GetRentalSummary()</span>
                    </span>
                    <span class="card-arrow" aria-hidden="true">→</span>
                </a>

                <a class="summary-card" href="/bills">
                    <span class="summary-icon bill-icon" aria-hidden="true">$</span>
                    <span class="summary-copy">
                        <small>Bills to review</small>
                        <strong>@_attentionBillCount</strong>
                        <span>@GetBillSummary()</span>
                    </span>
                    <span class="card-arrow" aria-hidden="true">→</span>
                </a>

                <a class="summary-card" href="/maintenance">
                    <span class="summary-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" focusable="false">
                            <path d="m14.5 6.5 3-3a4 4 0 0 1-5 5l-6.8 6.8a2.4 2.4 0 1 1-3-3l6.8-6.8a4 4 0 0 1 5-5l-3 3 3 3Z" />
                        </svg>
                    </span>
                    <span class="summary-copy">
                        <small>Active requests</small>
                        <strong>@_activeRequestCount</strong>
                        <span>@GetRequestSummary()</span>
                    </span>
                    <span class="card-arrow" aria-hidden="true">→</span>
                </a>

                <a class="summary-card" href="/notifications">
                    <span class="summary-icon notification-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" focusable="false">
                            <path d="M18 9a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9Z" />
                            <path d="M10 21h4" />
                        </svg>
                    </span>
                    <span class="summary-copy">
                        <small>Unread updates</small>
                        <strong>@_unreadNotificationCount</strong>
                        <span>@(_unreadNotificationCount == 0 ? "You're all caught up" : "New activity needs a look")</span>
                    </span>
                    <span class="card-arrow" aria-hidden="true">→</span>
                </a>
            }
        </section>

        <div class="dashboard-columns">
            <section class="dashboard-panel">
                <header class="panel-heading">
                    <div>
                        <p class="eyebrow">Maintenance</p>
                        <h2>Recent requests</h2>
                    </div>
                    <a href="/maintenance">View all <span aria-hidden="true">→</span></a>
                </header>

                @if (_recentRequests.Count == 0)
                {
                    <div class="compact-empty">
                        <span aria-hidden="true">✓</span>
                        <div>
                            <strong>No maintenance activity</strong>
                            <p>New requests and status changes will appear here.</p>
                        </div>
                    </div>
                }
                else
                {
                    <div class="item-list">
                        @foreach (var request in _recentRequests)
                        {
                            <a class="list-item" href="@($"/maintenance/{request.Id}")">
                                <span class="item-marker @GetPriorityCssClass(request.Priority)"></span>
                                <span class="item-main">
                                    <strong>@request.Title</strong>
                                    <small>@FormatMaintenanceCategory(request.Category) · <LocalDateTime Value="request.UpdatedAtUtc" Display="LocalDateTimeDisplay.Relative" /></small>
                                </span>
                                <span class="status-pill @GetMaintenanceStatusCssClass(request.Status)">
                                    @FormatMaintenanceStatus(request.Status)
                                </span>
                            </a>
                        }
                    </div>
                }
            </section>

            <section class="dashboard-panel">
                <header class="panel-heading">
                    <div>
                        <p class="eyebrow">Shared finances</p>
                        <h2>Upcoming bills</h2>
                    </div>
                    <a href="/bills">View all <span aria-hidden="true">→</span></a>
                </header>

                @if (_upcomingBills.Count == 0)
                {
                    <div class="compact-empty">
                        <span aria-hidden="true">$</span>
                        <div>
                            <strong>No bills need attention</strong>
                            <p>Published household expenses will appear here.</p>
                        </div>
                    </div>
                }
                else
                {
                    <div class="item-list">
                        @foreach (var bill in _upcomingBills)
                        {
                            <a class="list-item" href="@($"/bills/{bill.Id}")">
                                <span class="bill-date" aria-hidden="true">
                                    <small>@bill.DueDate.ToString("MMM")</small>
                                    <strong>@bill.DueDate.Day</strong>
                                </span>
                                <span class="item-main">
                                    <strong>@bill.Title</strong>
                                    <small>@FormatBillCategory(bill.Category) · Due @FormatDueDate(bill.DueDate)</small>
                                </span>
                                <span class="bill-amount">@FormatMoney(bill.TotalAmount, bill.Currency)</span>
                            </a>
                        }
                    </div>
                }
            </section>
        </div>

        @if (_isLandlord)
        {
            <section class="dashboard-panel applications-panel">
                <header class="panel-heading">
                    <div>
                        <p class="eyebrow">Rental applications</p>
                        <h2>Recent applicants</h2>
                    </div>
                    <a href="/rental-applications">Review all <span aria-hidden="true">→</span></a>
                </header>

                @if (_recentApplications.Count == 0)
                {
                    <div class="compact-empty">
                        <span aria-hidden="true">✓</span>
                        <div>
                            <strong>No applications waiting</strong>
                            <p>New applications to your listings will appear here.</p>
                        </div>
                    </div>
                }
                else
                {
                    <div class="application-list">
                        @foreach (var application in _recentApplications)
                        {
                            <a class="application-item" href="/rental-applications">
                                <span class="applicant-avatar" aria-hidden="true">
                                    @GetInitials(application.ApplicantName)
                                </span>
                                <span class="item-main">
                                    <strong>@application.ApplicantName</strong>
                                    <small>@application.ListingTitle · @application.RentalUnitName</small>
                                </span>
                                <span class="application-meta">
                                    <span class="@($"status-pill application-status-{application.Status.ToString().ToLowerInvariant()}")">
                                        @application.Status
                                    </span>
                                    <LocalDateTime Value="application.CreatedAtUtc" Display="LocalDateTimeDisplay.Relative" />
                                </span>
                            </a>
                        }
                    </div>
                }
            </section>
        }

        <section class="dashboard-panel activity-panel">
            <header class="panel-heading">
                <div>
                    <p class="eyebrow">Latest activity</p>
                    <h2>Updates for you</h2>
                </div>
                <a href="/notifications">Open notifications <span aria-hidden="true">→</span></a>
            </header>

            @if (_recentNotifications.Count == 0)
            {
                <div class="compact-empty">
                    <span aria-hidden="true">•</span>
                    <div>
                        <strong>Nothing new yet</strong>
                            <p>Applications, requests, and other updates will be collected here.</p>
                    </div>
                </div>
            }
            else
            {
                <div class="activity-list">
                    @foreach (var notification in _recentNotifications)
                    {
                        <a class="activity-item @(notification.IsRead ? string.Empty : "unread")"
                           href="@notification.TargetPath">
                            <span class="activity-dot" aria-hidden="true"></span>
                            <span>
                                <strong>@notification.Title</strong>
                                <small>@notification.Message</small>
                            </span>
                            <LocalDateTime Value="notification.CreatedAtUtc" Display="LocalDateTimeDisplay.Relative" />
                        </a>
                    }
                </div>
            }
        </section>
    }
</main>

@code {
    private readonly List<MaintenanceTenancyOption> _tenancies = [];
    private readonly List<MaintenanceRequestSummary> _recentRequests = [];
    private readonly List<SharedBillSummary> _upcomingBills = [];
    private readonly List<UserNotificationItem> _recentNotifications = [];
    private readonly List<ManagedRentalApplication> _recentApplications = [];
    private string _displayName = "there";
    private string? _errorMessage;
    private int _propertyCount;
    private int _unitCount;
    private int _occupiedUnitCount;
    private int _publishedListingCount;
    private int _pendingApplicationCount;
    private int _activeRequestCount;
    private int _attentionBillCount;
    private int _urgentRequestCount;
    private int _overdueBillCount;
    private int _unreadNotificationCount;
    private bool _isLandlord;
    private bool _isLoading = true;

    protected override Task OnInitializedAsync() => LoadDashboardAsync();

    private async Task LoadDashboardAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            var profile = await CurrentUserProfileService
                .GetRequiredUserProfileAsync();
            _displayName = profile.DisplayName;

            var authenticationState = await AuthenticationStateProvider
                .GetAuthenticationStateAsync();
            _isLandlord = authenticationState.User.IsInRole("Landlord");

            var tenancies = await MaintenanceService
                .GetAvailableTenanciesAsync(profile.Id);
            var requests = await MaintenanceService
                .GetVisibleRequestsAsync(profile.Id);
            var bills = await SharedBillService
                .GetVisibleBillsAsync(profile.Id);
            var notifications = await NotificationService
                .GetRecentAsync(profile.Id, 6);
            _unreadNotificationCount = await NotificationService
                .GetUnreadCountAsync(profile.Id);

            _tenancies.Clear();
            _tenancies.AddRange(tenancies);

            _activeRequestCount = requests.Count(request =>
                request.Status is not MaintenanceStatus.Closed and
                    not MaintenanceStatus.Cancelled);
            _urgentRequestCount = requests.Count(request =>
                request.Status is not MaintenanceStatus.Closed and
                    not MaintenanceStatus.Cancelled &&
                request.Priority is MaintenancePriority.High or
                    MaintenancePriority.Emergency);
            _recentRequests.Clear();
            _recentRequests.AddRange(requests
                .OrderByDescending(request => request.UpdatedAtUtc)
                .Take(4));

            var today = DateOnly.FromDateTime(DateTime.UtcNow);
            var attentionBills = bills
                .Where(bill => bill.Status is
                    SharedBillStatus.Published or
                    SharedBillStatus.PartiallySettled or
                    SharedBillStatus.Disputed)
                .OrderBy(bill => bill.DueDate)
                .ToArray();
            _attentionBillCount = attentionBills.Length;
            _overdueBillCount = attentionBills.Count(bill =>
                bill.DueDate < today);
            _upcomingBills.Clear();
            _upcomingBills.AddRange(attentionBills.Take(4));

            _recentNotifications.Clear();
            _recentNotifications.AddRange(notifications.Take(4));

            ResetLandlordSummary();
            if (_isLandlord)
            {
                await LoadLandlordSummaryAsync(profile.Id);
            }
        }
        catch (Exception exception)
        {
            Console.Error.WriteLine(exception);
            _errorMessage =
                "Please try again. If the problem continues, contact support.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadLandlordSummaryAsync(Guid userProfileId)
    {
        var properties = await PropertyService
            .GetVisiblePropertiesAsync(userProfileId);
        var units = await RentalListingService
            .GetOwnedUnitsAsync(userProfileId);
        var applications = await RentalListingService
            .GetManagedApplicationsAsync(userProfileId);

        _propertyCount = properties.Count(property => property.CanManage);
        _unitCount = units.Count;
        _occupiedUnitCount = units.Count(unit => unit.HasTenants);
        _publishedListingCount = units.Count(unit => unit.IsPublished);
        _pendingApplicationCount = applications.Count(application =>
            application.Status == RentalApplicationStatus.Pending);

        _recentApplications.AddRange(applications
            .OrderByDescending(application => application.CreatedAtUtc)
            .Take(4));
    }

    private void ResetLandlordSummary()
    {
        _propertyCount = 0;
        _unitCount = 0;
        _occupiedUnitCount = 0;
        _publishedListingCount = 0;
        _pendingApplicationCount = 0;
        _recentApplications.Clear();
    }

    private string GetHeroDescription() => _isLandlord
        ? "Track your properties, published listings, applications, maintenance, and shared bills from one place."
        : "Keep up with your tenancy, shared bills, maintenance requests, and recent account activity.";

    private string GetPropertySummary() =>
        _unitCount == 0
            ? "No rental units added"
            : $"{_unitCount} unit{(_unitCount == 1 ? string.Empty : "s")} · {_occupiedUnitCount} occupied";

    private string GetListingSummary()
    {
        var unpublishedCount = Math.Max(0, _unitCount - _publishedListingCount);
        return unpublishedCount == 0
            ? "All eligible spaces are listed"
            : $"{unpublishedCount} space{(unpublishedCount == 1 ? string.Empty : "s")} not published";
    }

    private string GetApplicationSummary() =>
        _pendingApplicationCount == 0
            ? "No applications waiting"
            : "Waiting for your review";

    private string GetRequestSummary() =>
        _urgentRequestCount > 0
            ? $"{_urgentRequestCount} high priority"
            : _activeRequestCount == 0
                ? "No open work"
                : "Work currently in progress";

    private string GetBillSummary() =>
        _overdueBillCount > 0
            ? $"{_overdueBillCount} overdue"
            : _attentionBillCount == 0
                ? "Nothing outstanding"
                : "Published or in review";

    private string GetRentalSummary()
    {
        if (_tenancies.Count == 0)
        {
            return "No active rental linked";
        }

        var first = _tenancies[0];
        return _tenancies.Count == 1
            ? $"{first.PropertyName} · {first.RentalUnitName}"
            : $"{first.PropertyName} and {_tenancies.Count - 1} more";
    }

    private static string GetFirstName(string displayName)
    {
        var parts = displayName
            .Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length == 0 ? "there" : parts[0];
    }

    private static string GetInitials(string displayName)
    {
        var parts = displayName
            .Split(' ', StringSplitOptions.RemoveEmptyEntries);

        return parts.Length switch
        {
            0 => "?",
            1 => parts[0][..1].ToUpperInvariant(),
            _ => string.Concat(parts[0][..1], parts[^1][..1])
                .ToUpperInvariant()
        };
    }

    private static string FormatDueDate(DateOnly dueDate)
    {
        var today = DateOnly.FromDateTime(DateTime.UtcNow);
        var days = dueDate.DayNumber - today.DayNumber;

        return days switch
        {
            < 0 => $"{Math.Abs(days)}d overdue",
            0 => "today",
            1 => "tomorrow",
            _ => dueDate.ToString("MMM d")
        };
    }

    private static string FormatMoney(decimal amount, string currency) =>
        currency == "JPY" ? $"{currency} {amount:N0}" : $"{currency} {amount:N2}";

    private static string FormatMaintenanceStatus(MaintenanceStatus status) =>
        status switch
        {
            MaintenanceStatus.InProgress => "In progress",
            _ => status.ToString()
        };

    private static string GetMaintenanceStatusCssClass(MaintenanceStatus status) =>
        $"status-{status.ToString().ToLowerInvariant()}";

    private static string GetPriorityCssClass(MaintenancePriority priority) =>
        priority switch
        {
            MaintenancePriority.High => "priority-high",
            MaintenancePriority.Emergency => "priority-emergency",
            _ => string.Empty
        };

    private static string FormatMaintenanceCategory(MaintenanceCategory category) =>
        category switch
        {
            MaintenanceCategory.HeatingCooling => "Heating and cooling",
            MaintenanceCategory.LocksAndSecurity => "Locks and security",
            MaintenanceCategory.PestControl => "Pest control",
            _ => category.ToString()
        };

    private static string FormatBillCategory(SharedBillCategory category) =>
        category.ToString();
}
