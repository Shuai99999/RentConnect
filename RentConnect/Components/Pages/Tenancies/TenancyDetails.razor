@page "/tenancies/{TenancyId:guid}"
@attribute [Authorize]
@rendermode InteractiveServer

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@using RentConnect.Application.Tenancies
@using RentConnect.Services

@inject ITenancyService TenancyService
@inject CurrentUserProfileService CurrentUserProfileService

<PageTitle>@(_tenancy is null ? "Tenancy" : $"{_tenancy.PropertyName} tenancy")</PageTitle>

<main class="tenancy-details-page">
    @if (_isLoading)
    {
        <section class="state-card">Loading tenancy...</section>
    }
    else if (_tenancy is null)
    {
        <section class="state-card error-card"><h1>Tenancy not found</h1><p>It does not exist or you no longer have access.</p><a class="secondary-button" href="/tenancies">Return to tenancies</a></section>
    }
    else
    {
        <BackNavigation Href="/tenancies" Label="Tenancies" />
        <header class="tenancy-header">
            <div>
                <div class="heading-meta"><span class="access-badge @(_tenancy.CanManage ? "owner" : "resident")">@(_tenancy.CanManage ? "Manager view" : "Resident view")</span><span>@GetState()</span></div>
                <h1>@_tenancy.PropertyName</h1>
                <p>@_tenancy.RentalUnitName</p>
            </div>
            @if (_tenancy.CanManage && !_tenancy.IsCancelled)
            {
                <button type="button" class="secondary-button" @onclick="ToggleEditor">@(_showEditor ? "Close editor" : "Edit tenancy")</button>
            }
        </header>

        @if (_message is not null) { <div class="action-message success-message" role="status">@_message</div> }
        @if (_error is not null) { <div class="action-message error-message" role="alert">@_error</div> }

        <section class="overview-grid">
            <article class="overview-card"><span>Start date</span><strong>@_tenancy.StartDate.ToString("MMMM d, yyyy")</strong></article>
            <article class="overview-card"><span>End date</span><strong>@(_tenancy.EndDate?.ToString("MMMM d, yyyy") ?? "Ongoing")</strong></article>
            <article class="overview-card"><span>Household</span><strong class="large-value">@_tenancy.Members.Count(member => !member.LeftOn.HasValue)</strong><small>current members</small></article>
        </section>

        @if (_tenancy.CanManage && _showEditor)
        {
            <section class="panel editor-panel">
                <div class="section-heading"><div><p class="eyebrow">Lease period</p><h2>Edit tenancy</h2></div></div>
                <EditForm Model="EndDateInput" OnValidSubmit="SaveEndDateAsync" FormName="edit-tenancy">
                    <div class="field"><label for="tenancy-end">End date <span>Optional</span></label><InputDate id="tenancy-end" class="form-control" @bind-Value="EndDateInput.EndDate" /></div>
                    <div class="form-actions"><button type="button" class="text-button danger-text" @onclick="CancelTenancyAsync" disabled="@_isSaving">Cancel tenancy</button><button type="submit" class="primary-button" disabled="@_isSaving">Save end date</button></div>
                </EditForm>
            </section>
        }

        <section class="panel members-panel">
            <div class="section-heading">
                <div><p class="eyebrow">People</p><h2>Household members</h2><p>Members can access shared bills and tenancy-visible maintenance requests.</p></div>
                @if (_tenancy.CanManage && !_tenancy.IsCancelled) { <a class="primary-button" href="/rental-applications">View rental applications</a> }
            </div>

            @if (_tenancy.Members.Count == 0)
            {
                <div class="empty-row"><strong>No members yet</strong><p>Publish this rental space and approve an application to connect the first resident.</p></div>
            }
            else
            {
                <div class="member-list">
                    @foreach (var member in _tenancy.Members)
                    {
                        <article class="member-row">
                            <span class="member-avatar">@GetInitial(member.DisplayName)</span>
                            <div><strong>@member.DisplayName</strong><p>@member.Email</p><small>Joined @member.JoinedOn.ToString("MMM d, yyyy")@(member.LeftOn.HasValue ? $" · Left {member.LeftOn.Value:MMM d, yyyy}" : string.Empty)</small></div>
                            @if (_tenancy.CanManage && !member.LeftOn.HasValue && !_tenancy.IsCancelled)
                            {
                                <button type="button" class="text-button danger-text" disabled="@_isSaving" @onclick="() => MarkLeftAsync(member)">End membership</button>
                            }
                        </article>
                    }
                </div>
            }
        </section>

    }
</main>

@code {
    [Parameter] public Guid TenancyId { get; set; }
    private RentConnect.Application.Tenancies.TenancyDetails? _tenancy;
    private Guid _userId;
    private bool _isLoading = true, _isSaving, _showEditor;
    private string? _message, _error;
    private EndDateModel EndDateInput { get; } = new();

    protected override async Task OnParametersSetAsync()
    {
        _userId = await CurrentUserProfileService.GetRequiredUserProfileIdAsync();
        await ReloadAsync(); _isLoading = false;
    }

    private async Task ReloadAsync() => _tenancy = await TenancyService.GetDetailsAsync(TenancyId, _userId);
    private void ToggleEditor() { _showEditor = !_showEditor; if (_showEditor && _tenancy is not null) EndDateInput.EndDate = _tenancy.EndDate; }

    private Task SaveEndDateAsync() => RunAsync(async () => { await TenancyService.UpdateEndDateAsync(new UpdateTenancyEndDateCommand(TenancyId, EndDateInput.EndDate), _userId); _showEditor = false; }, "Tenancy end date updated.");
    private Task CancelTenancyAsync() => RunAsync(async () => { await TenancyService.CancelAsync(TenancyId, _userId); _showEditor = false; }, "Tenancy cancelled.");
    private Task MarkLeftAsync(TenancyMemberItem member) => RunAsync(() => TenancyService.MarkMemberLeftAsync(new MarkTenancyMemberLeftCommand(TenancyId, member.UserProfileId, DateOnly.FromDateTime(DateTime.Today)), _userId), $"{member.DisplayName}'s membership ended.");

    private async Task RunAsync(Func<Task> action, string success)
    {
        if (_isSaving) return; _isSaving = true; _error = null; _message = null;
        try { await action(); await ReloadAsync(); _message = success; }
        catch (Exception exception) { Console.Error.WriteLine(exception); _error = exception is InvalidOperationException or ArgumentException ? exception.Message : "The change could not be saved. Please try again."; }
        finally { _isSaving = false; }
    }

    private string GetState() => _tenancy!.IsCancelled ? "Cancelled" : _tenancy.EndDate is { } end && end < DateOnly.FromDateTime(DateTime.Today) ? "Ended" : _tenancy.StartDate > DateOnly.FromDateTime(DateTime.Today) ? "Upcoming" : "Active";
    private static string GetInitial(string value) => string.IsNullOrWhiteSpace(value) ? "?" : value.Trim()[..1].ToUpperInvariant();
    private sealed class EndDateModel { public DateOnly? EndDate { get; set; } }
}
