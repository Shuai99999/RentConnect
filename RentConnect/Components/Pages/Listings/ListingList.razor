@page "/listings"
@attribute [Authorize]
@rendermode InteractiveServer
@implements IAsyncDisposable

@using Microsoft.AspNetCore.Authorization
@using Microsoft.JSInterop
@using RentConnect.Application.Listings
@using RentConnect.Core
@using RentConnect.Core.Enums

@inject IRentalListingService ListingService
@inject IConfiguration Configuration
@inject IJSRuntime JS

<PageTitle>Find a home</PageTitle>

<main class="listing-page">
    <header class="page-header">
        <div>
            <p class="eyebrow">Available rentals</p>
            <h1>Find a place that feels right</h1>
            <p>Search by city, explore the map, and compare available rental spaces.</p>
        </div>
        <a class="secondary-button" href="/properties">Manage properties</a>
    </header>

    <form class="search-panel" role="search" aria-label="Find rentals by location"
          @onsubmit="SearchByCityAsync" @onsubmit:preventDefault>
        <div class="search-field city-field">
            <label for="listing-city">Where do you want to live?</label>
            <input id="listing-city" type="search" placeholder="Try Edmonton or Calgary"
                   @bind="_city" @bind:event="oninput" disabled="@_isLoading" list="nearby-cities" />
            <datalist id="nearby-cities">
                @foreach (var city in AlbertaRentalSearch.Cities)
                {
                    <option value="@city"></option>
                }
            </datalist>
        </div>
        <div class="search-field radius-field">
            <label for="listing-radius">Search area</label>
            <select id="listing-radius" @bind="_radiusKm" disabled="@_isLoading">
                <option value="0">This city</option>
                <option value="10">Within 10 km</option>
                <option value="25">Within 25 km</option>
                <option value="50">Within 50 km</option>
                <option value="100">Within 100 km</option>
            </select>
        </div>
        <button class="primary-button search-button" type="submit" disabled="@_isLoading">Search homes</button>
        <button class="location-button" type="button" @onclick="UseMyLocationAsync"
                disabled="@(_isLoading || _isLocating)" aria-busy="@_isLocating">
            <svg viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="12" cy="12" r="3"></circle>
                <circle cx="12" cy="12" r="8"></circle>
                <path d="M12 2V5M12 19v3M2 12h3M19 12h3"></path>
            </svg>
            @(_isLocating ? "Finding you…" : "Use my location")
        </button>

        @if (_filterError is not null)
        {
            <p class="search-note" role="alert">@_filterError</p>
        }
    </form>

    <div class="results-heading">
        <div>
            <p class="eyebrow">Map search</p>
            <h2>@ResultsTitle</h2>
        </div>
        @if (_appliedCity is not null)
        {
            <button class="text-button" type="button" @onclick="ClearCityAsync" disabled="@_isLoading">
                View all rentals
            </button>
        }
    </div>

    <div class="explore-layout @(!_mapEnabled ? "map-unavailable" : null)">
        <section class="map-panel" aria-label="Rental property map">
            <div class="map-toolbar">
                <span><strong>@MappedPropertyCount</strong> properties on the map</span>
                <span class="map-legend"><i></i> Available rental</span>
            </div>
            <div id="listing-map" class="listing-map" aria-label="Interactive map of available rental properties"></div>
            @if (!_mapEnabled)
            {
                <div class="map-setup" role="status">
                    <div class="map-setup-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24"><path d="m3 6 6-3 6 3 6-3v15l-6 3-6-3-6 3Z"/><path d="M9 3v15M15 6v15"/></svg>
                    </div>
                    <strong>Map setup needed</strong>
                    <span>Add an Azure Maps subscription key to display rental locations.</span>
                </div>
            }
        </section>

        <section class="results-panel" aria-label="Available rentals">
            @if (_isLoading)
            {
                <div class="state-card">Loading available rentals…</div>
            }
            else if (_error is not null)
            {
                <div class="state-card error-card" role="alert">
                    <h2>Unable to load listings</h2><p>@_error</p>
                </div>
            }
            else if (_listings.Count == 0)
            {
                <div class="state-card empty-card" role="status">
                    <h2>@(_appliedCity is null ? "No homes are listed right now" : "No rentals match this area")</h2>
                    <p>@(_appliedCity is null ? "Check back soon for new rental spaces." : "Try a larger search area or view all rentals.")</p>
                </div>
            }
            else
            {
                <div class="listing-grid">
                    @foreach (var listing in _listings)
                    {
                        <article class="listing-card">
                            <a class="listing-image" href="@($"/listings/{listing.Id}")" aria-label="View @listing.Title">
                                @if (listing.CoverImageId is Guid imageId)
                                {
                                    <img src="@($"/rental-units/images/{imageId}")" alt="" loading="lazy" />
                                }
                                else
                                {
                                    <svg viewBox="0 0 64 64" aria-hidden="true"><path d="M8 30 32 11l24 19M14 27v27h36V27M25 54V38h14v16" /></svg>
                                }
                                <span class="type-badge">@(listing.TenantCount > 0 ? "Shared space" : FormatType(listing.UnitType))</span>
                            </a>
                            <div class="listing-body">
                                <p class="listing-location">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.5"/></svg>
                                    @listing.City@FormatRegion(listing.Region)
                                    @if (listing.DistanceKm is double distance)
                                    {
                                        <span> · @distance.ToString("0.#") km</span>
                                    }
                                </p>
                                <h3><a href="@($"/listings/{listing.Id}")">@listing.Title</a></h3>
                                <p>@listing.PropertyName · @listing.RentalUnitName</p>
                                <div class="listing-footer">
                                    <strong>$@listing.MonthlyRent.ToString("N0")<small>/month</small></strong>
                                    <span>Available @listing.AvailableFrom.ToString("MMM d")</span>
                                </div>
                            </div>
                        </article>
                    }
                </div>
            }
        </section>
    </div>
</main>

@code {
    private IReadOnlyList<PublicListingSummary> _listings = [];
    private IJSObjectReference? _mapModule;
    private string? _mapInstanceId;
    private bool _isLoading = true;
    private bool _isLocating;
    private string? _error;
    private string? _filterError;
    private string _city = string.Empty;
    private string? _appliedCity;
    private int _radiusKm;

    private string? AzureMapsKey => Configuration["AzureMaps:SubscriptionKey"];
    private bool _mapEnabled => !string.IsNullOrWhiteSpace(AzureMapsKey);
    private int MappedPropertyCount => _listings
        .Where(item => item.Latitude.HasValue && item.Longitude.HasValue)
        .Select(item => item.PropertyId)
        .Distinct()
        .Count();

    private string ResultsTitle => _isLoading
        ? "Finding available homes"
        : $"{_listings.Count} {(_listings.Count == 1 ? "rental" : "rentals")}" +
          (_appliedCity is null ? " available" : $" near {_appliedCity}");

    protected override Task OnInitializedAsync() => LoadListingsAsync(null, 0);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            _mapModule = await JS.InvokeAsync<IJSObjectReference>("import", "./listing-map.js");
            if (_mapEnabled)
            {
                _mapInstanceId = Guid.NewGuid().ToString("N");
                await _mapModule.InvokeVoidAsync(
                    "initializeMap",
                    _mapInstanceId,
                    "listing-map",
                    AzureMapsKey,
                    GetMapListings());
            }
        }
        catch (JSException exception)
        {
            Console.Error.WriteLine(exception);
            _filterError = "The map could not be loaded. You can still browse the rental list.";
            StateHasChanged();
        }
    }

    private Task SearchByCityAsync()
    {
        if (_radiusKm > 0 && AlbertaRentalSearch.FindCentre(_city) is null)
        {
            _filterError = "Choose a suggested Alberta city for a distance search, or select This city.";
            return Task.CompletedTask;
        }

        return LoadListingsAsync(_city, _radiusKm);
    }

    private Task ClearCityAsync()
    {
        _city = string.Empty;
        _radiusKm = 0;
        return LoadListingsAsync(null, 0);
    }

    private async Task UseMyLocationAsync()
    {
        _isLocating = true;
        _filterError = null;
        try
        {
            _mapModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./listing-map.js");
            var location = await _mapModule.InvokeAsync<UserCoordinates>("locateUser", _mapInstanceId);
            var userCoordinate = new RentConnect.Core.ValueObjects.GeoCoordinate(location.Latitude, location.Longitude);
            var nearest = AlbertaRentalSearch.Cities
                .Select(city => new
                {
                    City = city,
                    DistanceKm = AlbertaRentalSearch.DistanceKm(
                        userCoordinate,
                        AlbertaRentalSearch.FindCentre(city)!)
                })
                .OrderBy(item => item.DistanceKm)
                .First();

            if (nearest.DistanceKm > 200)
            {
                _filterError = "Your location is outside the supported Alberta search area. Enter an Alberta city instead.";
                return;
            }

            _city = nearest.City;
            _radiusKm = 25;
            await LoadListingsAsync(_city, _radiusKm);
        }
        catch (JSException exception)
        {
            _filterError = exception.Message.Contains("denied", StringComparison.OrdinalIgnoreCase)
                ? "Location access was denied. Allow location access in your browser or enter a city."
                : "We could not determine your location. Enter a city to continue.";
        }
        finally
        {
            _isLocating = false;
        }
    }

    private async Task LoadListingsAsync(string? city, int radiusKm)
    {
        _isLoading = true;
        _error = null;
        _filterError = null;
        _appliedCity = string.IsNullOrWhiteSpace(city) ? null : city.Trim();

        try
        {
            _listings = radiusKm > 0 && _appliedCity is not null
                ? await ListingService.SearchNearbyAsync(_appliedCity, radiusKm)
                : await ListingService.SearchAsync(_appliedCity);
        }
        catch (Exception exception)
        {
            Console.Error.WriteLine(exception);
            _error = "Please try again.";
        }
        finally
        {
            _isLoading = false;
        }

        if (_mapModule is not null && _mapInstanceId is not null && _mapEnabled)
        {
            await _mapModule.InvokeVoidAsync("updateListings", _mapInstanceId, GetMapListings());
        }
    }

    private MapListing[] GetMapListings() => _listings
        .Where(item => item.Latitude.HasValue && item.Longitude.HasValue)
        .Select(item => new MapListing(
            item.Id,
            item.PropertyId,
            item.Title,
            item.PropertyName,
            item.City,
            item.Region,
            item.MonthlyRent,
            item.Latitude!.Value,
            item.Longitude!.Value))
        .ToArray();

    private static string FormatRegion(string? region) => string.IsNullOrWhiteSpace(region) ? string.Empty : $", {region}";
    private static string FormatType(RentalUnitType type) => type == RentalUnitType.EntireProperty ? "Entire property" : type.ToString();

    public async ValueTask DisposeAsync()
    {
        if (_mapModule is null)
        {
            return;
        }

        try
        {
            if (_mapInstanceId is not null)
            {
                await _mapModule.InvokeVoidAsync("disposeMap", _mapInstanceId);
            }
            await _mapModule.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private sealed record UserCoordinates(double Latitude, double Longitude);
    private sealed record MapListing(
        Guid Id,
        Guid PropertyId,
        string Title,
        string PropertyName,
        string City,
        string? Region,
        decimal MonthlyRent,
        double Latitude,
        double Longitude);
}
