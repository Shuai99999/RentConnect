@using RentConnect.Application.Properties
@using RentConnect.Core.Entities
@using RentConnect.Services
@inject IRentalUnitImageService Images
@inject CurrentUserProfileService CurrentUser
@inject ILogger<RentalUnitGallery> Logger

<section class="property-gallery" aria-label="Rental space photographs">
    @if (_loading)
    {
        <p>Loading photographs...</p>
    }
    else if (_images.Count == 0)
    {
        <p class="photo-empty">No photographs have been added for this rental space yet.</p>
    }
    <div class="property-photo-grid">
        @foreach (var image in _images)
        {
            <figure @key="image.Id">
                <img src="@($"/rental-units/images/{image.Id}")" alt="Rental space photograph" loading="lazy" />
                @if (CanManage)
                {
                    <button type="button" class="text-button danger-text" disabled="@_busy" @onclick="() => DeleteAsync(image.Id)">Remove photograph</button>
                }
            </figure>
        }
    </div>
    @if (CanManage)
    {
        <div class="property-photo-picker">
            <label for="@_inputId">Choose a photograph</label>
            <InputFile id="@_inputId" OnChange="SelectAsync" accept="image/jpeg,image/png" disabled="@(_busy || _images.Count >= 10)" />
            <small>JPEG or PNG, up to 5 MB each. Maximum 10 photographs. The first photograph is this rental space's listing cover.</small>
        </div>

        @if (_preview is not null)
        {
            <figure class="property-photo-preview">
                <img src="@_preview" alt="Selected rental space photograph preview" />
                <figcaption>@_selectedFile?.Name</figcaption>
            </figure>
            <div class="form-actions">
                <button type="button" class="primary-button" disabled="@_busy" @onclick="UploadAsync">Upload photograph</button>
                <button type="button" class="text-button" disabled="@_busy" @onclick="ClearSelection">Cancel</button>
            </div>
        }

        @if (_busy) { <p role="status">Saving photograph...</p> }
    }
    @if (_error is not null) { <p class="photo-error" role="alert">@_error</p> }
    @if (_message is not null) { <p class="photo-success" role="status">@_message</p> }
</section>

@code {
    [Parameter] public Guid RentalUnitId { get; set; }
    [Parameter] public bool CanManage { get; set; }

    private readonly string _inputId = $"rental-unit-photo-{Guid.NewGuid():N}";
    private Guid _user;
    private bool _busy;
    private bool _loading = true;
    private string? _error;
    private string? _message;
    private string? _preview;
    private IBrowserFile? _selectedFile;
    private IReadOnlyList<RentalUnitImageItem> _images = [];

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _user = await CurrentUser.GetRequiredUserProfileIdAsync();
            await ReloadAsync();
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Could not load rental unit photographs.");
            _error = "Photographs could not be loaded. Please refresh the page.";
        }
        finally
        {
            _loading = false;
        }
    }

    private Task ReloadAsync() => LoadImagesAsync();

    private async Task LoadImagesAsync()
    {
        _images = await Images.GetAsync(RentalUnitId, _user);
    }

    private async Task SelectAsync(InputFileChangeEventArgs args)
    {
        _error = null;
        _message = null;
        ClearSelection();

        try
        {
            var file = args.File;
            if (file.Size == 0 || file.Size > RentalUnitImage.MaxBytes)
            {
                throw new ArgumentException("Choose a photograph between 1 byte and 5 MB.");
            }

            if (file.ContentType is not ("image/jpeg" or "image/png"))
            {
                throw new ArgumentException("Choose a JPEG or PNG photograph.");
            }

            var previewFile = await file.RequestImageFileAsync("image/png", 640, 480);
            await using var stream = previewFile.OpenReadStream(RentalUnitImage.MaxBytes);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            _preview = $"data:image/png;base64,{Convert.ToBase64String(buffer.ToArray())}";
            _selectedFile = file;
        }
        catch (Exception exception)
        {
            Logger.LogWarning(exception, "Could not preview rental unit photograph.");
            _error = "That photograph could not be previewed. Choose a JPEG or PNG file up to 5 MB.";
        }
    }

    private async Task UploadAsync()
    {
        if (_busy || _selectedFile is null) return;

        _busy = true;
        _error = null;
        _message = null;
        try
        {
            await using var stream = _selectedFile.OpenReadStream(RentalUnitImage.MaxBytes);
            await Images.AddAsync(RentalUnitId, _user, stream);
            await ReloadAsync();
            ClearSelection();
            _message = "Photograph uploaded for this rental space.";
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Could not upload rental unit photograph.");
            _error = exception is ArgumentException or IOException or InvalidOperationException
                ? exception.Message
                : "The photograph could not be saved. Please try again.";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeleteAsync(Guid imageId)
    {
        if (_busy) return;

        _busy = true;
        _error = null;
        _message = null;
        try
        {
            await Images.DeleteAsync(imageId, _user);
            await ReloadAsync();
            _message = "Photograph removed.";
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Could not remove rental unit photograph.");
            _error = "The photograph could not be removed. Please refresh and try again.";
        }
        finally
        {
            _busy = false;
        }
    }

    private void ClearSelection()
    {
        _selectedFile = null;
        _preview = null;
    }
}
