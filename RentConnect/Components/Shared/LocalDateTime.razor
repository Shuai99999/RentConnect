@implements IAsyncDisposable
@inject IJSRuntime JS

<time @ref="_element" datetime="@Value.ToUniversalTime().ToString("O")">
    @FallbackText
</time>

@code {
    [Parameter, EditorRequired]
    public DateTimeOffset Value { get; set; }

    [Parameter]
    public LocalDateTimeDisplay Display { get; set; } =
        LocalDateTimeDisplay.DateTime;

    private ElementReference _element;
    private IJSObjectReference? _module;
    private DateTimeOffset? _renderedValue;
    private LocalDateTimeDisplay? _renderedDisplay;

    private string FallbackText => Display switch
    {
        LocalDateTimeDisplay.Date =>
            $"{Value:MMMM d, yyyy} UTC",
        LocalDateTimeDisplay.Relative =>
            $"{Value:MMM d, yyyy} UTC",
        _ => $"{Value:MMM d, yyyy 'at' HH:mm} UTC"
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        _module ??= await JS.InvokeAsync<IJSObjectReference>(
            "import",
            "./Components/Shared/LocalDateTime.razor.js");

        if (_renderedValue == Value &&
            _renderedDisplay == Display)
        {
            return;
        }

        await _module.InvokeVoidAsync(
            "formatLocalDateTime",
            _element,
            Value.ToUniversalTime().ToString("O"),
            Display.ToString());

        _renderedValue = Value;
        _renderedDisplay = Display;
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
