@rendermode InteractiveServer

@using RentConnect.Application.Notifications
@using RentConnect.Services

@inject AuthenticationStateProvider AuthenticationStateProvider
@inject CurrentUserProfileService CurrentUserProfileService
@inject INotificationService NotificationService

<header class="site-header">
    <div class="header-content">
        <a class="brand" href="/" aria-label="RentConnect home">
            <span class="brand-mark" aria-hidden="true">
                <svg viewBox="0 0 40 40" focusable="false">
                    <g class="brand-logo-secondary">
                        <path d="M17.5 15.5 25 9l10 8.5" />
                        <path d="M22 13v15h10V15" />
                    </g>
                    <path d="M5 19 14 11.2 23 19" />
                    <path d="M8.5 17v11h11V17" />
                    <path d="M12 28v-6h4v6" />
                    <path class="brand-logo-link" d="M18.5 22h5" />
                    <circle class="brand-logo-node" cx="18.5" cy="22" r="1.4" />
                    <circle class="brand-logo-node" cx="23.5" cy="22" r="1.4" />
                </svg>
            </span>

            <span class="brand-text">
                <strong>RentConnect</strong>
                <small>Rental management</small>
            </span>
        </a>

        <nav class="primary-navigation"
             aria-label="Primary navigation">
            <AuthorizeView>
                <Authorized>
                    <NavLink href=""
                             Match="NavLinkMatch.All">
                        Dashboard
                    </NavLink>

                    <NavLink href="listings">
                        Find a home
                    </NavLink>

                    <NavLink href="properties">
                        Properties
                    </NavLink>

                    <AuthorizeView Roles="Landlord" Context="landlordContext">
                        <NavLink href="rental-applications">
                            Applications
                        </NavLink>
                    </AuthorizeView>

                    <NavLink href="tenancies">
                        Tenancies
                    </NavLink>

                    <NavLink href="maintenance">
                        Maintenance
                    </NavLink>

                    <NavLink href="bills">
                        Bills
                    </NavLink>
                </Authorized>
            </AuthorizeView>
        </nav>

        <div class="account-navigation">
            <AuthorizeView>
                <Authorized>
                    <NavLink class="notifications-link"
                             href="notifications">
                        <svg class="notification-icon"
                             viewBox="0 0 24 24"
                             aria-hidden="true">
                            <path d="M18 9a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9Z" />
                            <path d="M10 21h4" />
                        </svg>
                        <span class="notification-label">Notifications</span>

                        @if (_unreadCount > 0)
                        {
                            <span class="notification-count"
                                  aria-label="@($"{_unreadCount} unread notifications")">
                                @FormatUnreadCount(_unreadCount)
                            </span>
                        }
                    </NavLink>

                    <NavLink class="account-profile"
                             href="Account/Manage"
                             title="@_currentUserEmail">
                        <span class="user-avatar" aria-hidden="true">
                            @_currentUserInitial
                        </span>

                        <span class="user-summary">
                            <strong>@_currentUserDisplayName</strong>
                            <small>@_currentUserEmail</small>
                        </span>
                    </NavLink>

                    <form action="Account/Logout"
                          method="post">
                        <AntiforgeryToken />

                        <input type="hidden"
                               name="returnUrl"
                               value="" />

                        <button class="logout-button"
                                type="submit">
                            Log out
                        </button>
                    </form>
                </Authorized>

                <NotAuthorized>
                    <NavLink href="Account/Login">
                        Log in
                    </NavLink>

                    <NavLink class="register-link"
                             href="Account/Register">
                        Create account
                    </NavLink>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </div>
</header>

@code {
    private int _unreadCount;
    private string _currentUserDisplayName = "Account";
    private string _currentUserEmail = string.Empty;
    private string _currentUserInitial = "U";

    protected override async Task OnInitializedAsync()
    {
        var authenticationState =
            await AuthenticationStateProvider
                .GetAuthenticationStateAsync();

        if (authenticationState.User.Identity
                ?.IsAuthenticated != true)
        {
            return;
        }

        var userProfile =
            await CurrentUserProfileService
                .GetRequiredUserProfileAsync();

        _currentUserDisplayName = userProfile.DisplayName;
        _currentUserEmail = userProfile.Email;
        _currentUserInitial = GetInitial(userProfile.DisplayName);

        _unreadCount =
            await NotificationService
                .GetUnreadCountAsync(userProfile.Id);
    }

    private static string FormatUnreadCount(int count)
    {
        return count > 99 ? "99+" : count.ToString();
    }

    private static string GetInitial(string displayName)
    {
        var trimmedName = displayName.Trim();

        return trimmedName.Length == 0
            ? "U"
            : trimmedName[..1].ToUpperInvariant();
    }
}
