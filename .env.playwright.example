# Copy these values to .env.playwright.local and use dedicated test accounts.
# Leave PLAYWRIGHT_BASE_URL commented out to test https://localhost:7114.
# PLAYWRIGHT_BASE_URL=https://your-app.azurewebsites.net

PLAYWRIGHT_USER_EMAIL=user@example.com
PLAYWRIGHT_USER_PASSWORD=replace-with-test-password

# A second account is required by the opt-in rental lifecycle workflow.
PLAYWRIGHT_APPLICANT_EMAIL=applicant@example.com
PLAYWRIGHT_APPLICANT_PASSWORD=replace-with-test-password

# Never enable writes against a shared development or production database.
PLAYWRIGHT_ALLOW_WRITES=false
